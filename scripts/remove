#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers
hermes_connectors_stop
if hermes_connectors_enabled; then
    ynh_config_remove_systemd "$app-connectors"
    yunohost service remove "$app-connectors"
    rm -f /etc/sudoers.d/arcenal-connectors /usr/local/libexec/arcenal-yunohost
    rm -f "/etc/nginx/conf.d/$app-connectors.conf"
    # Le coffre et son identité sont conservés pour récupération, jamais purgés implicitement.
fi
hermes_stop_legacy_services

# Arrête et désenregistre le service lorsqu'il a été créé. Les ressources v2
# se chargent ensuite de supprimer le code et, avec --purge, les données.
if systemctl list-unit-files "$app.service" --no-legend 2>/dev/null | grep -q "$app.service"; then
    ynh_systemctl --service="$app" --action="stop"
fi
if ynh_hide_warnings yunohost service status "$app" >/dev/null; then
    yunohost service remove "$app"
fi
ynh_config_remove_systemd
ynh_config_remove_nginx
hermes_retire_privileges
rm -f /usr/local/sbin/arcenal-assistance-provision /etc/arcenal-assistance/agent.json
