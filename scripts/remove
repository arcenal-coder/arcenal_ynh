#!/bin/bash

# ARCenal Agent remove script (YunoHost packaging v2)

source /usr/share/yunohost/helpers

# Stop and remove the service
ynh_systemctl --service="$app" --action="stop" || true
yunohost service remove "$app" || true

# Remove app dir and config; purge data only if purge was requested
ynh_safe_remove "$install_dir"
if [ "${YNH_APP_PURGE:-0}" = "1" ]; then
    ynh_safe_remove "/var/www/$app"
fi
