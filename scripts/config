#!/bin/bash

# Panneau de configuration ARCenal pour le packaging YunoHost v2.
# Les lectures n'altèrent jamais la configuration et les écritures passent
# par des fonctions dédiées afin de préserver les valeurs contenant un « / ».

source /usr/share/yunohost/helpers
ynh_abort_if_errors
source "$(dirname "$0")/_common.sh"
getter__enabled() {
    systemctl is-enabled --quiet "$app-gateway" 2>/dev/null && echo true || echo false
}

setter__enabled() {
    if [ "$enabled" = "true" ]; then
        ynh_print_warn "Le service de passerelles sera proposé dans une prochaine version ARCenal."
    fi
}

ynh_app_config_apply() {
    _ynh_app_config_apply
    arcenal_secure_data_permissions
    ynh_systemctl --service="$app" --action="restart"
}

ynh_app_config_run "$1"
