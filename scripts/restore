#!/bin/bash

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers
ynh_abort_if_errors
ynh_restore "$install_dir"
# L'instantané cohérent prime sur la copie tardive du dossier vivant.
if [ -f "$install_dir/.ynh-data-snapshot.tar" ]; then
    restored=$(mktemp -d "${data_dir}.restore.XXXXXX")
    tar --extract --file="$install_dir/.ynh-data-snapshot.tar" --directory="$restored"
    if [ -d "$data_dir" ]; then
        previous=$(mktemp -d "${data_dir}.before-restore.XXXXXX")
        mv "$data_dir" "$previous/data"
    fi
    mv "$restored" "$data_dir"
else
    ynh_die "La sauvegarde ne contient pas d'instantané cohérent des données Hermes."
fi
chown -R "root:$app" "$install_dir"
chown -R "$app:$app" "$data_dir"
chmod 700 "$data_dir"
ynh_restore "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_restore "/etc/systemd/system/$app.service"
nodejs_version=$(ynh_app_setting_get --key=nodejs_version)
hermes_node="/opt/node_n/n/versions/node/$nodejs_version/bin/node"
test -x "$hermes_node" || ynh_die "Le runtime Node YunoHost restauré est absent."
ynh_app_setting_set --key=hermes_node --value="$hermes_node"
ynh_config_add_systemd --template=arcenal.service
hermes_admin_permission
systemctl enable "$app.service" --quiet
yunohost service add "$app" --description="ARCenal Agent" --log="$data_dir/logs/gui.log"
hermes_start
ynh_systemctl --service=nginx --action=reload
