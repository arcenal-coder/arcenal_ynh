#!/bin/bash

# Restauration d'ARCenal Agent avec le packaging YunoHost v2.

source /usr/share/yunohost/helpers
source "$(dirname "$0")/_common.sh"

# YunoHost exclut les données applicatives de la sauvegarde automatique qui
# précède une mise à niveau. Elles restent alors en place et leur absence dans
# l'archive ne doit pas faire échouer la restauration du cœur applicatif.
ynh_restore_file --origin_path="/var/www/$app/data" --not_mandatory
ynh_restore_file --origin_path="/var/lib/$app-control" --not_mandatory

if [ ! -d "/var/www/$app/data" ]; then
    ynh_die "Le dossier de données ARCenal est absent après la restauration."
fi

# Les sauvegardes antérieures au garde YunoHost ne contiennent pas ce marqueur.
printf '%s\n' 'managed-by-yunohost' > "/var/www/$app/data/.arcenal-yunohost"
chmod 600 "/var/www/$app/data/.arcenal-yunohost"
chown "$app:" "/var/www/$app/data/.arcenal-yunohost"

# Réinstalle les sources et dépendances, puis régénère les configurations.
ynh_setup_source --dest_dir="$install_dir"
chown -R "$app:" "$install_dir"
arcenal_install_control_user
arcenal_prepare_control_state
arcenal_install_security_bridge
arcenal_install_deps

web_base="${path%/}/"
arcenal_build_interfaces "$web_base"

ynh_config_add_nginx
ynh_config_add_systemd --template="arcenal.service"
arcenal_start_security_bridge
ynh_systemctl --service="$app" --action="start"
