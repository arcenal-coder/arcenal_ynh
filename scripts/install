#!/bin/bash

# Installation d'ARCenal Agent avec le packaging YunoHost v2.

#=================================================
# IMPORT DES OUTILS YUNOHOST
#=================================================
source /usr/share/yunohost/helpers

#=================================================
# RÉCUPÉRATION DES SOURCES
#=================================================
ynh_setup_source --dest_dir="$install_dir"

#=================================================
# UTILISATEUR SYSTÈME ET PERMISSIONS
#=================================================
# L'agent exécute des commandes : il reste donc confiné à son utilisateur dédié.
chown -R "$app:" "$install_dir"
find "$install_dir" -type d -exec chmod 750 {} \;
find "$install_dir" -type f -exec chmod 640 {} \;

# Installe le canal de maintenance à privilèges strictement bornés.
install -o root -g root -m 0755 ../conf/arcenal-supervisor-helper /usr/local/sbin/arcenal-supervisor-helper
sed "s/__APP__/$app/g" ../conf/arcenal-supervisor-sudoers > "/etc/sudoers.d/$app-supervisor"
chmod 0440 "/etc/sudoers.d/$app-supervisor"
visudo -cf "/etc/sudoers.d/$app-supervisor"

#=================================================
# INSTALLATION DES DÉPENDANCES (uv + environnement Python)
#=================================================
ynh_exec_as_app env \
    HOME="$install_dir" \
    UV_INSTALL_DIR="$install_dir/.local/bin" \
    sh -c 'curl -LsSf https://astral.sh/uv/0.12.9/install.sh | sh'
ynh_exec_as_app env \
    HOME="$install_dir" \
    UV_PYTHON_INSTALL_DIR="$install_dir/.uv/python" \
    "$install_dir/.local/bin/uv" sync \
        --directory "$install_dir" --python 3.11 --no-dev

# Construit l'interface depuis la racine du monorepo, où se trouve le lockfile.
web_base="${path%/}/"
ynh_exec_as_app env HOME="$install_dir" \
    npm --prefix "$install_dir" ci --workspace web
ynh_exec_as_app env HOME="$install_dir" \
    npm --prefix "$install_dir" run build --workspace web -- --base="$web_base"

#=================================================
# CONFIGURATION NON INTERACTIVE
#=================================================
data_dir="/var/www/$app/data"
mkdir -p "$data_dir"
chmod 700 "$data_dir"

# Preuve que l'exécution ARCenal a été installée par le paquet YunoHost officiel.
printf '%s\n' 'managed-by-yunohost' > "$data_dir/.arcenal-yunohost"
chmod 600 "$data_dir/.arcenal-yunohost"

cat > "$data_dir/config.yaml" <<EOF
# Géré par YunoHost (application arcenal).
model:
  provider: $provider
  default: $model
terminal:
  backend: local
EOF

if [ -n "$api_key" ]; then
    provider_env="$(echo "$provider" | tr '[:lower:]-' '[:upper:]_')"
    printf '%s_API_KEY=%s\n' "$provider_env" "$api_key" > "$data_dir/.env"
    chmod 600 "$data_dir/.env"
fi
chown -R "$app:" "$data_dir"

#=================================================
# CONFIGURATION NGINX
#=================================================
ynh_config_add_nginx
ynh_permission_url --permission="main" --url="$domain$path" --auth_header=true

#=================================================
# CONFIGURATION SYSTEMD
#=================================================
ynh_config_add_systemd --template="arcenal.service"

yunohost service add "$app" --description="ARCenal Agent — self-hosted AI agent web UI" --log="/var/log/$app/$app.log"

#=================================================
# DÉMARRAGE DU SERVICE
#=================================================
ynh_systemctl --service="$app" --action="start"
