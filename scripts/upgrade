#!/bin/bash

# Mise à niveau d'ARCenal Agent avec le packaging YunoHost v2.
# Les versions sont gérées par YunoHost afin de conserver une base Hermes
# commune et facilement actualisable.

source /usr/share/yunohost/helpers
source "$(dirname "$0")/model_config.sh"

data_dir="/var/www/$app/data"
config_file="$data_dir/config.yaml"

#=================================================
# ARRÊT DU SERVICE
#=================================================
ynh_systemctl --service="$app" --action="stop"

#=================================================
# RÉCUPÉRATION DES NOUVELLES SOURCES
#=================================================
ynh_setup_source --dest_dir="$install_dir"
chown -R "$app:" "$install_dir"

# Réinstalle le helper et sa règle à chaque mise à niveau du paquet.
install -o root -g root -m 0755 ../conf/arcenal-supervisor-helper /usr/local/sbin/arcenal-supervisor-helper
sed "s/__APP__/$app/g" ../conf/arcenal-supervisor-sudoers > "/etc/sudoers.d/$app-supervisor"
chmod 0440 "/etc/sudoers.d/$app-supervisor"
visudo -cf "/etc/sudoers.d/$app-supervisor"

#=================================================
# MISE À JOUR DES DÉPENDANCES
#=================================================
ynh_exec_as_app env \
    HOME="$install_dir" \
    UV_PYTHON_INSTALL_DIR="$install_dir/.uv/python" \
    "$install_dir/.local/bin/uv" sync \
        --directory "$install_dir" --python 3.11 --no-dev || \
    ynh_die "Failed to sync Python dependencies — check $install_dir/.local/bin/uv"

ynh_exec_as_app env HOME="$install_dir" \
    npm --prefix "$install_dir" ci --workspace web
web_base="${path%/}/"
ynh_exec_as_app env HOME="$install_dir" \
    npm --prefix "$install_dir" run build --workspace web -- --base="$web_base"

# Le dossier de données (configuration, secrets, compétences et mémoire)
# reste volontairement intact pendant les mises à niveau.
arcenal_model_migrate_legacy "$config_file" "$app" "$app" || \
    ynh_die "La configuration historique du modèle est invalide."

#=================================================
# RÉAPPLICATION DES CONFIGURATIONS ET REDÉMARRAGE
#=================================================
ynh_config_add_nginx
ynh_permission_url --permission="main" --url="/" --auth_header=true
ynh_config_add_systemd --template="arcenal.service"
ynh_systemctl --service="$app" --action="restart"
