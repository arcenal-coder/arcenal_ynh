#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers
ynh_abort_if_errors
ynh_systemctl --service="$app" --action="stop"
hermes_stop_legacy_services
hermes_quiescent_data
# Le premier paquet ARC n'archivait pas le code. Conserver une copie complète
# de la transition en dehors du répertoire remplacé, sans publier de secret.
transition_dir="/var/cache/yunohost/appconfbackup/$app-native-transition"
install -d -o root -g root -m 0700 "$transition_dir"
transition=$(mktemp "$transition_dir/snapshot.XXXXXX")
tar --create --file="$transition" "$install_dir" "$data_dir" \
    "/etc/nginx/conf.d/$domain.d/$app.conf" "/etc/systemd/system/$app.service"
chmod 600 "$transition"
for artifact in "/etc/sudoers.d/$app-supervisor" /usr/local/sbin/arcenal-supervisor-helper \
    /usr/local/sbin/arcenal-privileged-broker /usr/local/sbin/arcenal-nginx-reload \
    /usr/local/sbin/arcenal-control-socket-ready "/etc/systemd/system/${app}_control.service" \
    "/etc/systemd/system/${app}_broker.service" "/var/lib/$app-control"; do
    if [ -e "$artifact" ]; then
        tar --append --file="$transition" "$artifact"
    fi
done
hermes_build
hermes_configure
hermes_retire_privileges
hermes_start
