#!/bin/bash

# Helper privilégié ARCenal : aucune commande arbitraire n’est acceptée.
set -euo pipefail

operation="${1:-}"
target="${2:-}"

case "$operation" in
    refresh-diagnostics)
        test -z "$target"
        yunohost diagnosis run --force
        ;;
    reload-nginx)
        test -z "$target"
        nginx -t
        systemctl reload nginx
        echo "Configuration Nginx validée et service rechargé."
        ;;
    restart-service)
        case "$target" in
            arcenal|nginx|yunohost-api|yunohost-portal-api|slapd)
                systemctl restart "$target"
                systemctl is-active "$target"
                ;;
            *)
                echo "Service non autorisé." >&2
                exit 64
                ;;
        esac
        ;;
    yunohost-query)
        case "$target" in
            version)
                yunohost --version
                ;;
            apps)
                yunohost app list --output-as json
                ;;
            services)
                yunohost service status --output-as json
                ;;
            *)
                echo "Ressource YunoHost non autorisée." >&2
                exit 64
                ;;
        esac
        ;;
    *)
        echo "Opération non autorisée." >&2
        exit 64
        ;;
esac
