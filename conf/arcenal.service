[Unit]
Description=Hermes Agent — dashboard natif YunoHost
After=network.target

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__DATA_DIR__
Environment=PYTHONPATH=__INSTALL_DIR__
Environment=HOME=__DATA_DIR__
# Place le dossier personnel de l'agent dans les données persistantes.
Environment=HERMES_HOME=__DATA_DIR__
Environment=HERMES_RUNTIME_DIR=__DATA_DIR__/tools
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HERMES_NODE=__HERMES_NODE__
# Le TUI est compilé par le paquet : aucune acquisition PM ou rebuild au clic Chat.
Environment=HERMES_TUI_DIR=__INSTALL_DIR__/ui-tui
# Interdit les assistants interactifs dans le service.
Environment=HERMES_NONINTERACTIVE=1
# L'interface est déjà construite pendant l'installation ou la mise à niveau.
Environment=HERMES_WEB_DIST=__INSTALL_DIR__/hermes_cli/web_dist
# Les mises à jour restent pilotées par le paquet YunoHost.
Environment=HERMES_DISABLE_UPDATE=1
ExecStart=__HERMES_PYTHON__ __INSTALL_DIR__/hermes dashboard --host 127.0.0.1 --port __PORT__ --skip-build --no-open
Restart=on-failure
RestartSec=5

# Cloisonnement du service qui peut exécuter des commandes locales.
NoNewPrivileges=true
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__DATA_DIR__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
