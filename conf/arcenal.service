[Unit]
Description=ARCenal Agent — self-hosted AI agent web UI
After=network.target

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__
Environment=HOME=__DATA_DIR__
# Place le dossier personnel de l'agent dans les données persistantes.
Environment=HERMES_HOME=__DATA_DIR__
# ARCenal vérifie ce marqueur du paquet avant d'exécuter le code Hermes.
Environment=ARCENAL_YUNOHOST_MARKER=__DATA_DIR__/.arcenal-yunohost
# Interdit les assistants interactifs dans le service.
Environment=HERMES_NONINTERACTIVE=1
# L'interface est déjà construite pendant l'installation ou la mise à niveau.
Environment=HERMES_WEB_DIST=__INSTALL_DIR__/hermes_cli/web_dist
# Déclare l'adresse publique servie par YunoHost pour valider l'en-tête Host.
Environment=HERMES_DASHBOARD_PUBLIC_URL=https://__DOMAIN____PATH__
# Les mises à jour restent pilotées par le paquet YunoHost.
Environment=HERMES_DISABLE_UPDATE=1
ExecStart=__INSTALL_DIR__/.venv/bin/arcenal dashboard --host 127.0.0.1 --port __PORT__ --skip-build --no-open
Restart=on-failure
RestartSec=5

# Cloisonnement du service qui peut exécuter des commandes locales.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__DATA_DIR__ __INSTALL_DIR__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
