[Unit]
Description=ARCenal Agent — self-hosted AI agent web UI
After=network.target

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__
Environment=HOME=__DATA_DIR__
# Le chemin Node fourni par la ressource YunoHost doit aussi exister au runtime.
Environment="PATH=__PATH_WITH_NODEJS__"
# Place le dossier personnel de l'agent dans les données persistantes.
Environment=ARCENAL_HOME=__DATA_DIR__
Environment=HERMES_HOME=__DATA_DIR__
Environment=ARCENAL_RELEASE=0.21.0-arcenal36
Environment=ARCENAL_PACKAGE_VERSION=0.21.0~ynh54
Environment=ARCENAL_SOURCE_REVISION=4b7acf426fda42fd8576dbc764dd2360b6f3502a
# Le journal d'audit doit rester dans l'espace persistant autorisé par ProtectSystem.
Environment=ARCENAL_AUDIT_DIR=__DATA_DIR__/arcenal/audit
# Utilise le terminal préconstruit par le paquet, sans installation au premier chat.
Environment=HERMES_TUI_DIR=__INSTALL_DIR__/ui-tui
# ARCenal vérifie ce marqueur du paquet avant d'exécuter le code Hermes.
Environment=ARCENAL_YUNOHOST_MARKER=__DATA_DIR__/.arcenal-yunohost
# Interdit les assistants interactifs dans le service.
Environment=HERMES_NONINTERACTIVE=1
# L'interface est déjà construite pendant l'installation ou la mise à niveau.
Environment=HERMES_WEB_DIST=__INSTALL_DIR__/hermes_cli/web_dist
# Les mises à jour restent pilotées par le paquet YunoHost.
Environment=HERMES_DISABLE_UPDATE=1
# La surface ARC exclut le terminal, les processus et les fichiers arbitraires.
Environment=HERMES_TUI_TOOLSETS=arcenal-admin
Environment=ARCENAL_READONLY_SOCKET=/run/arcenal-readonly/query.sock
ExecStart=__INSTALL_DIR__/.venv/bin/arcenal dashboard --host 127.0.0.1 --port __PORT__ --skip-build --no-open
Restart=on-failure
RestartSec=5
UMask=0077

# Les actions root appartiennent désormais au broker séparé.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__DATA_DIR__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
